# Chave de Acesso do Web3Forms para recebimento de mensagens no formulário
# Obtenha sua chave gratuita e instantânea em: https://web3forms.com/
VITE_WEB3FORMS_ACCESS_KEY=

# URL pública do site, sem barra no final (ex.: https://meusite.com).
# Usada em og:image, og:url e canonical, que precisam de endereço absoluto.
# Na Vercel pode ficar vazia: o build usa o domínio de produção automaticamente.
VITE_SITE_URL=
